# ============================================================================
# The Group of Joining Hands - environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#
# SECRET_KEY and JWT_SECRET are mandatory in production - the server refuses to
# start without them. Generate each one separately with:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

APP_ENV=development          # set to "production" when deploying

SECRET_KEY=
JWT_SECRET=

# Comma-separated list. Only these origins receive credentialed CORS responses.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

HOST=0.0.0.0
PORT=8080

# Optional - only needed if Google sign-in is enabled
GOOGLE_CLIENT_ID=
